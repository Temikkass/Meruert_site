# .env.example
# ------------------------------------------------------------------------------
# Copy to .env.local and fill in before running the contact form (next phase)
# or connecting a future CMS (see README.md — "Future CMS Integration").

# Site URL, used to override config/seo.ts#baseUrl in non-production environments
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Reserved for the contact form's email-sending provider (e.g. Resend) once
# react-hook-form + zod submission is wired up in the build phase.
# EMAIL_PROVIDER_API_KEY=
