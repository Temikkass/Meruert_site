# .env.example
# ------------------------------------------------------------------------------
# Copy to .env.local and fill in before deploying, or when connecting a future
# CMS (see README.md — "Future CMS Integration").

# Absolute origin of the deployed site, no trailing slash. Read by
# config/seo.ts#baseUrl, which feeds metadataBase, every canonical URL, Open
# Graph image resolution, sitemap.xml and robots.txt. REQUIRED in production:
# without it those all fall back to the placeholder domain in config/seo.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
