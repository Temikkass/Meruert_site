# .env.example
# ------------------------------------------------------------------------------
# Copy to .env.local and fill in before running the site or the admin panel.

# Absolute origin of the deployed site, no trailing slash. Read by
# config/seo.ts#baseUrl, which feeds metadataBase, every canonical URL, Open
# Graph image resolution, sitemap.xml and robots.txt. REQUIRED in production:
# without it those all fall back to the placeholder domain in config/seo.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Admin panel (Payload CMS). Both are REQUIRED — the site reads its content
# from this database at build time, so `next build` fails without them.
# ------------------------------------------------------------------------------

# PostgreSQL connection string.
#   local:      postgres://postgres:PASSWORD@localhost:5432/meruert
#   production: the connection string from Neon / Supabase / your host
DATABASE_URL=postgres://postgres:postgres@localhost:5432/meruert

# Signs admin session tokens. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out. Never commit the real value.
PAYLOAD_SECRET=replace-with-a-long-random-string

# ------------------------------------------------------------------------------
# Image storage. OPTIONAL in development, REQUIRED in production.
#
# Without these, uploads go to ./media on local disk. That is fine locally, and
# wrong on most hosts: Vercel and any container replaced on deploy have an
# ephemeral filesystem, so images uploaded through the admin would silently
# disappear on the next deploy with no way to recover them.
#
# Works with any S3-compatible provider — Cloudflare R2, Backblaze B2,
# DigitalOcean Spaces, MinIO, AWS S3. R2 has no egress fees, which suits an
# image-heavy site. Set all four (five for non-AWS) or none: a partially
# configured environment falls back to disk rather than failing to boot.
# ------------------------------------------------------------------------------

# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Required for R2 / Spaces / MinIO; omit entirely for AWS S3.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
